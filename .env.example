# Sahayak AI — Environment Variables Configuration

# Server Environment
ENV=development
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Backend URLs
SAHAYAK_API_BASE=http://127.0.0.1:8000/api/v1
CORS_ORIGINS=["*"]

# Optional AI Model Paths (Defaults use lightweight heuristic/MediaPipe CPU runtimes)
YOLO_MODEL_PATH=models/yolo11n.pt
ISL_STATIC_MODEL=models/CNN_landmarks_mode_71.h5
ISL_DYNAMIC_MODEL=models/dynamic_sign_language_model.h5
PLACES365_MODEL_PATH=models/resnet50_places365.pth.tar

# Optional Third-Party Services (Not required for local hackathon demo)
USE_CLOUD_TTS=False
GOOGLE_APPLICATION_CREDENTIALS=
OPENAI_API_KEY=
